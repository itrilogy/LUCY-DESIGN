  "typography": {
    "fontFamily": {
      "serif-zh":  { "value": "\"Songti SC\", \"Source Han Serif SC\", \"Noto Serif SC\", Georgia, serif", "usage": "沉浸页 / 文学性场景（听默·聆涧）" },
      "sans-zh":   { "value": "\"PingFang SC\", \"HarmonyOS Sans SC\", \"Microsoft YaHei\", \"Noto Sans SC\", system-ui, sans-serif", "usage": "默认：工作台 / 后台 / 表单" },
      "sans-latin":{ "value": "Inter, \"SF Pro Text\", system-ui, -apple-system, \"Segoe UI\", sans-serif", "usage": "拉丁文与数字混排" },
      "mono":      { "value": "\"JetBrains Mono\", \"SF Mono\", Menlo, Consolas, monospace", "usage": "代码 / DSL / 数字对齐" }
    },
    "fontSize": {
      "display":  { "value": "40px", "lineHeight": "1.15", "usage": "营销页主标" },
      "h1":       { "value": "28px", "lineHeight": "1.25", "usage": "页面标题" },
      "h2":       { "value": "22px", "lineHeight": "1.3", "usage": "区块标题" },
      "h3":       { "value": "17px", "lineHeight": "1.4", "usage": "卡片标题" },
      "body":     { "value": "14px", "lineHeight": "1.6", "usage": "正文（默认）" },
      "body-lg":  { "value": "16px", "lineHeight": "1.6", "usage": "长文正文" },
      "small":    { "value": "13px", "lineHeight": "1.5", "usage": "次级信息" },
      "caption":  { "value": "12px", "lineHeight": "1.45", "usage": "说明 / 表格注" },
      "micro":    { "value": "11px", "lineHeight": "1.4", "usage": "页码 / 角标 / 时间戳" }
    },
    "fontWeight": {
      "regular": { "value": 400 }, "medium": { "value": 500 },
      "semibold": { "value": 600 }, "bold": { "value": 700 }
    },
    "letterSpacing": {
      "tight":  { "value": "-0.02em", "usage": "大字号标题" },
      "normal": { "value": "0" },
      "wide":   { "value": "0.06em", "usage": "字锁 / 小标签" },
      "widest": { "value": "0.18em", "usage": "品牌字距（Slogan / 章节眉）" }
    }
  },

  "space": {
    "unit": { "value": "4px", "usage": "基准栅格：所有间距取 4 的整数倍" },
    "scale": {
      "0": { "value": "0" }, "1": { "value": "4px" }, "2": { "value": "8px" },
      "3": { "value": "12px" }, "4": { "value": "16px" }, "5": { "value": "20px" },
      "6": { "value": "24px" }, "8": { "value": "32px" }, "10": { "value": "40px" },
      "12": { "value": "48px" }, "16": { "value": "64px" }, "20": { "value": "80px" }
    }
