      "inverse-muted": { "value": "rgba(243,238,230,0.55)", "usage": "深色底上的辅助文本" }
    },
    "surface": {
      "page":        { "value": "#FFFFFF", "usage": "亮主题页面底" },
      "card":        { "value": "#F5F7FA", "usage": "亮主题卡片 / 面板" },
      "raised":      { "value": "#FFFFFF", "usage": "浮层 / 弹窗 / 下拉" },
      "dark-page":   { "value": "#121A17", "usage": "深林底：深色主题页面" },
      "dark-card":   { "value": "#1A2428", "usage": "深色主题卡片" },
      "dark-raised": { "value": "#22302B", "usage": "深色主题浮层" },
