      "line":   { "value": "rgba(13,94,66,0.18)", "usage": "常规描边" },
      "strong": { "value": "rgba(13,94,66,0.32)", "usage": "强调描边 / 选中" },
      "dark-line":   { "value": "rgba(245,247,250,0.14)", "usage": "深色主题常规描边" },
      "dark-subtle": { "value": "rgba(245,247,250,0.08)", "usage": "深色主题浅分割" }
