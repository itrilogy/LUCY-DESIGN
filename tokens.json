    "grid": { "value": "12 列 / gutter 24px（md 以上）；单列 ≤md", "usage": "标准栅格" },
    "sidebar": { "value": "240px", "usage": "左栏（库 / 导航 / 过滤）" },
    "headerHeight": { "value": "56px", "usage": "顶栏" },
    "zIndex": {
      "base": { "value": 0 }, "sticky": { "value": 100 }, "dropdown": { "value": 300 },
      "overlay": { "value": 600 }, "modal": { "value": 800 }, "toast": { "value": 1000 }
    }
  },

  "component": {
    "controlHeight": { "sm": "28px", "md": "36px", "lg": "44px" },
