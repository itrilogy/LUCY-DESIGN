{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "LUXI Design System",
  "version": "1.0.0",
  "description": "鹿溪联合创新实验室（LUXI Joint Innovation Lab）统一设计 tokens。核心四色来自 VI 规范，产品 accent 来自各工程既有实现。供设计工具 / 生成式 Agent / 前端工程共同消费。",
  "meta": {
    "owner": "鹿溪联合创新实验室（LUXI Joint Innovation Lab）",
    "slogan": "林深见鹿，源启清溪",
    "sloganEn": "Deep Insights, Evolutionary Origin.",
    "matrix": ["知行·三动", "具身·二察", "理数·三思", "工坊·一法"],
    "source": "Obsidian departments/lab · 04-VI视觉识别与设计Tokens",
    "license": "内部范式（产品代码许可各自遵循其仓库 LICENSE）"
  },

  "color": {
    "core": {
      "luxi-green":      { "value": "#0D5E42", "usage": "主底色、品牌识别、稳重底座" },
      "origin-white":    { "value": "#F5F7FA", "usage": "画布背景、面板反白、纯净" },
      "evolution-cyan":  { "value": "#00D2FF", "usage": "溪流曲线、源启星、数据高亮" },
      "title-gold":      { "value": "#F1C40F", "usage": "落点、显著信号、命中热区" }
    },
    "support": {
      "alert-red":  { "value": "#E74C3C", "usage": "警示、红球业务、异常" },
      "info-blue":  { "value": "#3498DB", "usage": "蓝球业务、次级信息" },
      "state-green": { "value": "#22C55E", "usage": "上涨 / 通过 / 成功（数据语境）" },
      "state-red":   { "value": "#EF4444", "usage": "下跌 / 失败 / 阻断（数据语境）" },
      "state-flat":  { "value": "#94A3B8", "usage": "持平 / 中性（数据语境）" }
