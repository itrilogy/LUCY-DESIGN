    "focusRing": { "value": "2px 实线 var(--luxi-cyan) + 2px offset", "usage": "键盘可达" },
    "tableRowHeight": { "comfortable": "44px", "compact": "36px" },
    "iconSize": { "sm": "16px", "md": "20px", "lg": "24px", "xl": "32px" }
  },

  "iconography": {
    "system": { "value": "线性为主，stroke 1.5–2px，圆角线帽；与产品方标 4 层语义结构呼应" },
    "assetSources": ["Lucide", "IconPark", "Tabler Icons", "Feather", "Heroicons", "Iconoir"],
    "brandMark": {
