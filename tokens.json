    "sm":   { "value": "6px", "usage": "按钮 / 卡片内元素" },
    "md":   { "value": "10px", "usage": "卡片 / 面板（默认）" },
    "lg":   { "value": "16px", "usage": "大面板 / 图库卡" },
    "pill": { "value": "999px", "usage": "胶囊按钮 / 标签 / 进度" },
    "tile": { "value": "12px", "usage": "产品方标绿底砖（512 视口下 rx=112）" }
  },

  "shadow": {
    "none":  { "value": "none" },
    "xs":    { "value": "0 1px 2px rgba(13,94,66,0.06)" },
    "sm":    { "value": "0 2px 8px rgba(13,94,66,0.08)" },
    "md":    { "value": "0 8px 24px rgba(13,94,66,0.10)" },
    "lg":    { "value": "0 16px 48px rgba(13,94,66,0.14)" },
    "focus": { "value": "0 0 0 3px rgba(0,210,255,0.35)", "usage": "键盘焦点环（必须可见）" },
    "glass": { "value": "inset 0 1px 0 rgba(255,255,255,0.24), 0 8px 32px rgba(0,0,0,0.32)", "usage": "毛玻璃面板" }
  },

  "motion": {
    "duration": {
      "instant": { "value": "80ms", "usage": "hover / 按下反馈" },
      "fast":    { "value": "160ms", "usage": "控件状态切换" },
      "base":    { "value": "240ms", "usage": "面板展开 / 页面元素入场" },
      "slow":    { "value": "400ms", "usage": "大区块过渡 / 视图切换" },
      "cinema":  { "value": "1200ms", "usage": "沉浸页呼吸 / Ken Burns 单程" }
    },
    "easing": {
      "standard": { "value": "cubic-bezier(0.2, 0, 0, 1)", "usage": "默认" },
      "enter":    { "value": "cubic-bezier(0.05, 0.7, 0.1, 1)", "usage": "入场减速" },
      "exit":     { "value": "cubic-bezier(0.3, 0, 0.8, 0.15)", "usage": "退场加速" },
      "linear":   { "value": "linear", "usage": "进度 / 连续动画" }
    },
    "reducedMotion": {
      "value": "respect prefers-reduced-motion: 取消位移/粒子/闪烁，仅保留 ≤160ms 的透明度过渡",
      "usage": "强制项：所有产品必须实现"
    }
  },

  "layout": {
    "breakpoints": {
      "sm": { "value": "640px" }, "md": { "value": "768px" },
      "lg": { "value": "1024px" }, "xl": { "value": "1280px" }, "2xl": { "value": "1536px" }
    },
