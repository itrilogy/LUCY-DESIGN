      "jianlu":  { "name": "见鹿 JianLu", "matrix": "知行·三动", "accent": "#0D5E42", "accent2": "#00D2FF", "motif": "键帽 · 光标 · 溪流", "density": "comfortable", "theme": "light" },
      "tingmo":  { "name": "听默 Tingmo", "matrix": "知行·三动", "accent": "#0D5E42", "accent2": "#00D2FF", "motif": "声纹弧 · 溪流", "density": "compact", "theme": "dark" },
      "tingmo-android": { "name": "听默 Android", "matrix": "知行·三动", "accent": "#0D5E42", "accent2": "#00D2FF", "motif": "声纹弧", "density": "compact", "theme": "dark" },
      "huiliu":  { "name": "绘流 HuiLiu", "matrix": "知行·三动", "accent": "#0D5E42", "accent2": "#F1C40F", "motif": "贝塞尔锚点 · 导出落点", "density": "comfortable", "theme": "dark-glass" },
      "lingjian":{ "name": "聆涧 LingJian", "matrix": "知行·三动", "accent": "#E8D4B0", "accent2": "#0D5E42", "motif": "山涧 · 一字生境", "density": "sparse", "theme": "ink" },
      "maixi":   { "name": "脉息 MaiXi", "matrix": "具身·二察", "accent": "#00D2FF", "accent2": "#0D5E42", "motif": "同心环 · 脉搏波", "density": "comfortable", "theme": "dark" },
      "shenwei": { "name": "审微 ShenWei", "matrix": "具身·二察", "accent": "#2F7A73", "accent2": "#F1C40F", "motif": "光学分划 · 隐患点", "density": "compact", "theme": "light" },
      "wenjin":  { "name": "问津 WenJin", "matrix": "理数·三思", "accent": "#0D5E42", "accent2": "#F1C40F", "motif": "双枝航道 · 落点", "density": "comfortable", "theme": "light" },
      "hengliu": { "name": "衡流 HengLiu", "matrix": "理数·三思", "accent": "#60A5FA", "accent2": "#F1C40F", "motif": "马尔可夫环 · K线", "density": "compact", "theme": "dark" },
      "guanlan": { "name": "观澜 GuanLan", "matrix": "理数·三思", "accent": "#E74C3C", "accent2": "#3498DB", "motif": "红蓝球 · 市场曲线", "density": "comfortable", "theme": "light" },
      "chengju": { "name": "澄矩 ChengJu", "matrix": "工坊·一法", "accent": "#0D5E42", "accent2": "#00D2FF", "motif": "控制限 · 正交走线", "density": "compact", "theme": "light" },
      "suzhi":   { "name": "溯知 SuZhi", "matrix": "工坊·一法", "accent": "#0D5E42", "accent2": "#F1C40F", "motif": "三信源汇流 · 成章", "density": "comfortable", "theme": "light" },
      "design":  { "name": "设计范式", "matrix": "实验室本体", "accent": "#0D5E42", "accent2": "#00D2FF", "motif": "溪流 · 源启星", "density": "comfortable", "theme": "light" }
    }
